# sk_pgp bundled-OpenSSL pin (supply-chain / reproducibility gate)
# ---------------------------------------------------------------------------
# The self-contained wheel bundles brew's PQC-capable libcrypto.so.3 under a
# private SONAME (see KNOWN_ISSUES.md section 1). auditwheel copies whatever
# `$OPENSSL_DIR/lib/libcrypto.so.3` resolves to at build time, so a silent brew
# upgrade would swap the bundled crypto library out from under us with no diff.
#
# These values PIN the exact library we intend to ship. scripts/verify-openssl-pin.sh
# recomputes the sha256 of the resolved libcrypto.so.3 and FAILS the build on any
# mismatch. On a deliberate OpenSSL upgrade, re-pin ON PURPOSE:
#   1. Confirm the new brew openssl@3 is the intended PQC build (ML-DSA/ML-KEM).
#   2. Update EXPECTED_OPENSSL_VERSION and EXPECTED_LIBCRYPTO_SHA256 below to the
#      new `openssl version` string and `sha256sum $(readlink -f
#      $OPENSSL_DIR/lib/libcrypto.so.3)`.
#   3. Commit the re-pin as its own reviewed change (never as a silent side effect).
#
# The private SONAME auditwheel assigns is `libcrypto-<first8hex>.so.3`, where the
# hash is the first 8 hex of this same sha256, a handy cross-check that the shipped
# wheel actually bundled the pinned lib (here: libcrypto-84a5b28d.so.3).

# `openssl version` output prefix we expect (space-safe compare on the version token).
EXPECTED_OPENSSL_VERSION="OpenSSL 3.6.2"

# sha256 of the resolved brew libcrypto.so.3 that gets bundled into the wheel.
EXPECTED_LIBCRYPTO_SHA256="84a5b28dfc17fbc6c28029f4feb85a696a51d5a32d46eb8d2963e3f4ff9ac250"
